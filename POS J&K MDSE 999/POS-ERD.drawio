        <mxCell id="rel-user-sales" value="processes · 1 to many" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#176B50;strokeWidth=2;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;fontSize=11;fontColor=#53665A;labelBackgroundColor=#F7F9F7;" edge="1" parent="1" source="users" target="sales"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel-sales-items" value="contains · 1 to many" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#176B50;strokeWidth=2;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;fontSize=11;fontColor=#53665A;labelBackgroundColor=#F7F9F7;" edge="1" parent="1" source="sales" target="items"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel-products-items" value="catalog reference · optional after product removal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#CB754B;strokeWidth=2;dashed=1;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;fontSize=11;fontColor=#81593F;labelBackgroundColor=#F7F9F7;" edge="1" parent="1" source="products" target="items"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="790" y="620"/><mxPoint x="790" y="320"/></Array></mxGeometry></mxCell>
        <mxCell id="note" value="&lt;b&gt;Relationship notes&lt;/b&gt;&lt;br&gt;• One user (admin or cashier) can process many sales.&lt;br&gt;• Each sale contains one or more sale item rows.&lt;br&gt;• Product link can be null; the sold name and price stay on the receipt snapshot.&lt;br&gt;• Removing products/users in the app deactivates them to preserve history." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EDF4EF;strokeColor=#D8E6DC;fontColor=#42544A;fontSize=12;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="65" y="515" width="710" height="150" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;PK&lt;/b&gt; Primary key &nbsp;&nbsp; &lt;b&gt;FK&lt;/b&gt; Foreign key &nbsp;&nbsp; Green line: required relationship &nbsp;&nbsp; Orange dashed line: optional product reference" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#7A8980;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="65" y="740" width="1000" height="30" as="geometry"/></mxCell>
