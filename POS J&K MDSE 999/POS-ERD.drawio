        <mxCell id="title" value="J&amp;K MDSE STORE 999&#xa;POINT OF SALE · DATABASE ERD" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=25;fontStyle=1;fontColor=#183F30;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="55" y="35" width="570" height="65" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="MySQL relational model · sales preserve item name and price snapshots" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#718078;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="57" y="98" width="590" height="28" as="geometry"/></mxCell>
        <mxCell id="users" value="&lt;b&gt;USERS&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt;  id : BIGINT&lt;br&gt;username : VARCHAR(60) · UNIQUE&lt;br&gt;password_hash : VARCHAR(255)&lt;br&gt;full_name : VARCHAR(120)&lt;br&gt;role : ADMIN | CASHIER&lt;br&gt;is_active : BOOLEAN&lt;br&gt;created_at : TIMESTAMP" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#176B50;strokeWidth=2;fontColor=#24332B;fontSize=13;align=left;verticalAlign=top;spacingLeft=16;spacingRight=12;spacingTop=14;shadow=1;" vertex="1" parent="1"><mxGeometry x="65" y="190" width="310" height="238" as="geometry"/></mxCell>
        <mxCell id="sales" value="&lt;b&gt;SALES&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt;  id : BIGINT&lt;br&gt;transaction_no : VARCHAR(40) · UNIQUE&lt;br&gt;&lt;b&gt;FK&lt;/b&gt;  user_id : BIGINT&lt;br&gt;subtotal : DECIMAL(12,2)&lt;br&gt;discount : DECIMAL(12,2)&lt;br&gt;total : DECIMAL(12,2)&lt;br&gt;amount_paid : DECIMAL(12,2)&lt;br&gt;change_due : DECIMAL(12,2)&lt;br&gt;created_at : TIMESTAMP" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#176B50;strokeWidth=2;fontColor=#24332B;fontSize=13;align=left;verticalAlign=top;spacingLeft=16;spacingRight=12;spacingTop=14;shadow=1;" vertex="1" parent="1"><mxGeometry x="445" y="175" width="330" height="282" as="geometry"/></mxCell>
        <mxCell id="items" value="&lt;b&gt;SALE_ITEMS&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt;  id : BIGINT&lt;br&gt;&lt;b&gt;FK&lt;/b&gt;  sale_id : BIGINT&lt;br&gt;&lt;b&gt;FK&lt;/b&gt;  product_id : BIGINT · nullable&lt;br&gt;product_name : VARCHAR(150) · snapshot&lt;br&gt;quantity : INT&lt;br&gt;unit_price : DECIMAL(12,2) · snapshot&lt;br&gt;line_total : DECIMAL(12,2)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CB754B;strokeWidth=2;fontColor=#24332B;fontSize=13;align=left;verticalAlign=top;spacingLeft=16;spacingRight=12;spacingTop=14;shadow=1;" vertex="1" parent="1"><mxGeometry x="825" y="190" width="310" height="238" as="geometry"/></mxCell>
